{
  "claude": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash \"$HOME/.config/claude/hooks/check-new-plugins.sh\"",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash \"$HOME/.config/claude/hooks/check-model-drift.sh\"",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash \"$HOME/.config/claude/hooks/sync-plugins.sh\"",
        "async": true,
        "timeout": 300
      },
      {
        "type": "command",
        "command": "bash \"$HOME/.config/claude/hooks/sync-mcp-servers.sh\"",
        "async": true,
        "timeout": 60
      },
      {
        "type": "command",
        "command": "bash \"$HOME/.config/claude/hooks/sync-models.sh\"",
        "async": true,
        "timeout": 60
      },
      {
        "type": "command",
        "command": "[ -f \"$HOME/.gemini/config/scripts/save-settings.sh\" ] && bash \"$HOME/.gemini/config/scripts/save-settings.sh\" || true",
        "async": true,
        "timeout": 10
      }
    ]
  },
  "codex": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ~/.config/codex/hooks/check-new-plugins.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash ~/.config/codex/hooks/check-model-drift.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash ~/.config/codex/hooks/sync-plugins.sh",
        "async": true,
        "timeout": 300
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "bash ~/.config/codex/hooks/save-config.sh",
        "timeout": 3
      }
    ]
  },
  "grok": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ~/.config/grok/hooks/sync-plugins.sh",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash ~/.config/grok/hooks/inject-context.sh",
        "timeout": 10
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "bash ~/.config/grok/hooks/save-config.sh",
        "timeout": 10
      }
    ]
  }
}
