{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/check-new-plugins.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/check-model-drift.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-plugins.sh\"",
            "async": true,
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-mcp-servers.sh\"",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-models.sh\"",
            "async": true,
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/common_hook.py\" --harness auto --event SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/common_hook.py\" --harness auto --event UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/common_hook.py\" --harness auto --event PreCompact",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/common_hook.py\" --harness auto --event PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/common_hook.py\" --harness auto --event PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/common_hook.py\" --harness auto --event Stop",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "model": "opusplan",
  "permissions": {
    "defaultMode": "auto"
  },
  "language": "japanese",
  "alwaysThinkingEnabled": true,
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.config/claude-powerline/record-rate-limits.sh",
    "padding": 0
  }
}
