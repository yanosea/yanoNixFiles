{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/load-handover.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/check-new-plugins.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/check-model-drift.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-plugins.sh\"",
            "async": true,
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-mcp-servers.sh\"",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-models.sh\"",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.gemini/config/scripts/save-settings.sh\" ] && bash \"$HOME/.gemini/config/scripts/save-settings.sh\" || true",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/remind-websearch.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/generate-handover.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "model": "opusplan",
  "permissions": {
    "defaultMode": "auto"
  },
  "language": "japanese",
  "alwaysThinkingEnabled": true,
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.config/claude-powerline/record-rate-limits.sh",
    "padding": 0
  }
}
