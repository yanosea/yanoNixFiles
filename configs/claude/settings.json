{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/load-handover.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/check-new-plugins.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-plugins.sh\"",
            "async": true,
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/sync-mcp-servers.sh\"",
            "async": true,
            "timeout": 60
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.gemini/config/scripts/save-settings.sh\" ] && bash \"$HOME/.gemini/config/scripts/save-settings.sh\" || true",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'IMPORTANT: if this task touches library/API versions, tool behavior, pricing, or best practices that may have changed since training, you MUST call WebSearch or WebFetch before answering. Do not rely on training-data memory for anything time-sensitive; skipping this when it applies is a mistake.'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/generate-handover.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "language": "japanese",
  "alwaysThinkingEnabled": true,
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "claude-powerline",
    "padding": 0
  }
}
