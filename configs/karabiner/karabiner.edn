{;; bundle identifiers for app conditions
 :applications {:finder ["^com\\.apple\\.finder$"],
                :remote ["^com\\.carriez\\.rustdesk$"],
                :vivaldi ["^com\\.vivaldi\\.Vivaldi$"],
                :wezterm ["^com\\.github\\.wez\\.wezterm$"]},
 ;; shell command templates
 :templates {:open "open -a \"%s\"", :osascript "osascript -e '%s'"},
 :layers {:layer-mode {:alone {:key :vk_none}, :key :left_command}},
 :devices {:builtin [{:product_id 641, :vendor_id 1452}]},
 :main
   [{:des "layer mode",
     :rules [:layer-mode
             ;; ctrl+h/l (word motion via ctrl+option+arrow, bound to
             ;; moveWordBackward:/moveWordForward: in
             ;; DefaultKeyBinding.dict; plain option+arrow is taken by
             ;; aerospace's resize binding, so word motion can't reuse it;
             ;; must precede the plain h/l entries; rustdesk needs raw
             ;; ctrl+arrow since the remote os interprets word motion
             ;; itself; wezterm doesn't need word
             ;; motion here)
             [:!T##h :!TOleft_arrow [:!remote :!wezterm]]
             [:!T##l :!TOright_arrow [:!remote :!wezterm]]
             [:!T##h :!Tleft_arrow :remote] [:!T##l :!Tright_arrow :remote]
             ;; vim bind cursor move (## passes any held modifiers through)
             [:##h :left_arrow] [:##j :down_arrow] [:##k :up_arrow]
             [:##l :right_arrow]
             ;; ime
             [:##spacebar :f13]
             ;; caps lock
             [:##tab :caps_lock]
             ;; home / end (cmd+arrow moves by line, not the whole
             ;; document; wezterm/rustdesk don't interpret cmd+arrow this
             ;; way, so send raw home/end there instead)
             [:#Sp [:!Cleft_arrow] [:!remote :!wezterm]]
             [:#Sr [:!Cright_arrow] [:!remote :!wezterm]] [:#Sp :home :remote]
             [:#Sr :end :remote] [:#Sp :home :wezterm] [:#Sr :end :wezterm]
             ;; page up / down
             [:##b :page_up] [:##f :page_down]
             ;; delete
             [:##delete_or_backspace :delete_forward]]}
    {:des "word motion (ctrl+arrow -> option+arrow, shift passes through)",
     :rules [[:!T#Sleft_arrow :!Oleft_arrow :!remote]
             [:!T#Sright_arrow :!Oright_arrow :!remote]]}
    {:des "windows style shortcuts",
     :rules
       [;; alt + f4 -> quit app
        [:!Of4 :!Cq [:!remote :!vivaldi :!wezterm]]
        ;; ctrl + shift + esc -> activity monitor
        [:!TSescape [:open "Activity Monitor"] [:!remote :!vivaldi :!wezterm]]
        ;; cmd + e -> finder
        [:!Ce [:open "Finder"] [:!remote :!vivaldi :!wezterm]]
        ;; cmd + i -> system settings
        [:!Ci [:open "System Settings"] [:!remote :!vivaldi :!wezterm]]
        ;; cmd + d -> show desktop
        [:!Cd [:osascript "tell application \"System Events\" to key code 103"]
         [:!remote :!vivaldi :!wezterm]]
        ;; ctrl + return -> cmd + return
        [:!Treturn_or_enter :!Creturn_or_enter [:!finder :!remote :!wezterm]]
        ;; ctrl + w -> cmd + w (close window/tab)
        [:!Tw :!Cw [:!remote :!vivaldi :!wezterm]]]}
    {:des "finder",
     :rules [;; ctrl + return -> open
             [:!Treturn_or_enter :!Co :finder]
             ;; f2 -> rename
             [:f2 :return_or_enter :finder]
             ;; alt + up -> parent folder
             [:!Oup_arrow :!Cup_arrow :finder]]}
    {:des "built-in keyboard change",
     :rules [:builtin
             ;; capslock -> left ctrl
             [:##caps_lock :left_control]
             ;; left option -> left command
             [:##left_option :left_command]
             ;; left control -> left option
             [:##left_control :left_option]]}]}
