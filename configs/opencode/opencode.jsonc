{
  "$schema": "https://opencode.ai/config.json",
  // nix owns the binary
  "update": "disable",
  "share": "disabled",
  // fallback for sessions with no agent model; keep it on go so the catalog
  // never falls back to a pay-as-you-go model
  "model": "opencode-go/deepseek-v4.1-flash",
  // manager routes work to the agents in agents/
  "default_agent": "manager",
  // the personal console sign-in keeps a member budget for go extra usage, so
  // its pay-as-you-go models are hidden; paid work goes through opencode-premium
  "policies": [{ "action": "provider.use", "resource": "opencode", "effect": "deny" }],
  "providers": {
    // console pay-as-you-go through a service-account key from sops, exported
    // by zsh (configs/zsh/rc/credentials.zsh) and the background service
    "opencode-premium": {
      "name": "OpenCode Premium",
      "env": ["OPENCODE_PREMIUM_API_KEY"],
      "canonical": "opencode",
      "package": "@opencode/ai/providers/anthropic",
      "settings": { "baseURL": "https://opencode.ai/inference/anthropic/v1" },
      "models": { "claude-opus-5-5": {}, "claude-fable-5-1": {} }
    }
  },
  // the built-ins would bypass manager's routing: general runs on the parent's
  // model with no subagent rules, build and plan skip manager entirely
  "agents": {
    "build": { "disabled": true },
    "plan": { "disabled": true },
    "general": { "disabled": true }
  },
  // the other agent clis run in auto mode
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  // opencode's own vendor plugins; opencode fetches them from npm,
  // so versions are pinned here. the ones shared with the other clis come
  // from configs/agents/plugins.conf into opencode.json beside this file,
  // and opencode joins the plugins of both
  "plugins": [
    "@firecrawl/opencode@1.3.0",
    // subscription quota, with its tui line; settings in opencode-quota/
    "@slkiser/opencode-quota@5.0.3",
    "opencode-tavily@1.0.0"
  ]
  // the mcp servers come from configs/agents/mcp-servers.conf, into opencode.json
}
