{
  "$schema": "https://opencode.ai/config.json",
  // nix owns the binary
  "update": "disable",
  "share": "disabled",
  // fallback for sessions with no agent model; keep it on go so the catalog
  // never falls back to a pay-as-you-go model
  "model": "opencode-go/kimi-k3",
  // manager routes work to the agents in agents/
  "default_agent": "manager",
  "providers": {
    // console pay-as-you-go through a service-account key from sops, exported
    // by zsh (configs/zsh/rc/credentials.zsh) and the background service
    "opencode-premium": {
      "name": "OpenCode Premium",
      "env": ["OPENCODE_PREMIUM_API_KEY"],
      "canonical": "opencode",
      "package": "@opencode/ai/providers/anthropic",
      "settings": { "baseURL": "https://opencode.ai/inference/anthropic/v1" },
      "models": { "claude-opus-5-5": {}, "claude-fable-5-1": {} }
    }
  },
  // the built-ins would bypass manager's routing: general runs on the parent's
  // model with no subagent rules, build and plan skip manager entirely
  "agents": {
    "build": { "disabled": true },
    "plan": { "disabled": true },
    "general": { "disabled": true }
  },
  // the other agent clis run in auto mode
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  // vendor plugins matching the claude ones; opencode fetches them from npm,
  // so versions are pinned here
  "plugins": [
    "@firecrawl/opencode@1.3.0",
    // subscription quota, with its tui line; settings in opencode-quota/
    "@slkiser/opencode-quota@5.0.3",
    "opencode-tavily@1.0.0",
    // registers its skills and always-on ruleset itself
    "@dietrichgebert/ponytail@5.3.2",
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.0"
  ],
  // same servers as configs/agents/mcp-servers.conf
  "mcp": {
    "servers": {
      "comfyui": {
        "type": "local",
        "command": ["npx", "-y", "comfyui-mcp"],
        "environment": { "COMFYUI_URL": "http://127.0.0.1:8188" }
      },
      "invokeai": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "invokeai-mcp-server",
          "--with",
          "mcp<2",
          "python",
          "-m",
          "invokeai_mcp_server"
        ]
      },
      "rea": {
        "type": "local",
        "command": ["npx", "-y", "rea-agents@6.7.0", "mcp"]
      }
    }
  }
}
