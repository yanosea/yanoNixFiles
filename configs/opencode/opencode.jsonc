{
  "$schema": "https://opencode.ai/config.json",
  // nix owns the binary
  "update": "disable",
  "share": "disabled",
  // xai's flagship on the supergrok login, left on its default effort;
  // build runs on it
  "model": "xai/grok-4.7",
  "providers": {
    // same models and effort as configs/codex/config.toml, on the chatgpt login
    "openai": {
      "models": {
        "gpt-6-astra": {
          "settings": { "reasoningEffort": "high" }
        },
        "gpt-6.1-sol": {
          "settings": { "reasoningEffort": "high" }
        }
      }
    }
  },
  // grok does the everyday work; the chatgpt login is kept for planning
  // and review, where grok skipped steps in the agent-trial runs
  "agents": {
    "plan": {
      "model": { "providerID": "openai", "model": "gpt-6-astra" }
    },
    "explore": {
      "model": { "providerID": "xai", "model": "grok-4.7-build-fast" }
    },
    "review": {
      "description": "Reviews the diff once a change is done: missed requirements, edge cases such as missing directories or unsupported platforms, and claims the code does not back up",
      "mode": "subagent",
      "model": { "providerID": "openai", "model": "gpt-6.1-sol" },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  // the other agent clis run in auto mode
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  // vendor plugins matching the claude ones; opencode fetches them from npm,
  // so versions are pinned here
  "plugins": [
    "@firecrawl/opencode@1.3.0",
    // subscription quota, with its tui line; settings in opencode-quota/
    "@slkiser/opencode-quota@5.0.2",
    "opencode-tavily@1.0.0"
  ],
  // same servers as configs/agents/mcp-servers.conf
  "mcp": {
    "servers": {
      "comfyui": {
        "type": "local",
        "command": ["npx", "-y", "comfyui-mcp"],
        "environment": { "COMFYUI_URL": "http://127.0.0.1:8188" }
      },
      "invokeai": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "invokeai-mcp-server",
          "--with",
          "mcp<2",
          "python",
          "-m",
          "invokeai_mcp_server"
        ]
      }
    }
  }
}
