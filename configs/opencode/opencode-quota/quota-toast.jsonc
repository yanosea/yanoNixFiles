{
  // opencode go and zen; zen needs `opencode auth login opencode` (a console sign-in, not an api key)
  "enabledProviders": ["opencode-go", "opencode"],
  "tuiCommandDisplay": "inline",
  // one line below the prompt, like the other clis' statusline
  "tuiCompactStatus": { "enabled": true },
  // every window per provider, not just the tightest one
  "formatStyle": "allWindows",
  // used, limit and remaining, plus zen's balance and auto-reload rows
  "accountingDetail": "detailed",
  // five-hour, weekly and monthly
  "opencodeGoWindows": ["rolling", "weekly", "monthly"],
  // 5.0.3 draws the sidebar panel either way; off only leaves it empty.
  // the collapsed panel shows go's five-hour row
  "tuiSidebarPanel": { "enabled": true, "opencodeGoPreferredWindow": "rolling" },
  "enableToast": false,
  // the tui writes $XDG_CACHE_HOME/opencode/quota-export.json for plugins to read
  "export": { "enabled": true },
  "maintainerAnnouncements": { "enabled": false }
}
