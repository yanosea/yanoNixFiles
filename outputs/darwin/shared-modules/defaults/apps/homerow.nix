# homerow configuration
_: {
  # system
  system = {
    defaults = {
      CustomUserPreferences = {
        "com.superultra.Homerow" = {
          "auto-switch-input-source-id" = "jp.sourceforge.inputmethod.aquaskk.Ascii";
          "chain-clicks" = false;
          "check-for-updates-automatically" = false;
          "enable-hyper-key" = true;
          "launch-at-login" = true;
          "non-search-shortcut" = "⌃⇧A";
          "scroll-shortcut" = "⇧⌘J";
        };
      };
    };
  };
}
